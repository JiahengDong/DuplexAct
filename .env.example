# Copy to .env and fill in the keys you need.

# Closed-source realtime APIs
OPENAI_API_KEY=
GEMINI_API_KEY=
DASHSCOPE_API_KEY=
XAI_API_KEY=

# Subsequent / backchannel judges (OpenAI)
# OPENAI_API_KEY is also used by evaluation/metrics/run_metrics.py
# and evaluation/direct_replay/evaluation/asr_openai.py (whisper-1).

# Hugging Face (write token needed only to publish LincolnD/DuplexAct)
# HF_TOKEN=

# Optional overrides
# DUPLEXACT_ROOT=/path/to/DuplexAct
# BENCH_ROOT=/path/to/DuplexAct
# OPENSOURCE_MODELS_ROOT=/path/to/checkpoints
# CANDOR_ROOT=/path/to/Candor
